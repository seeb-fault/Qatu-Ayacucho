{
  "name": "qatu-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "playwright test --project=descubrimiento",
    "test:usuarios": "playwright test --config playwright.usuarios.config.ts",
    "test:acceso": "playwright test --config playwright.acceso.config.ts",
    "test:proveedores": "playwright test --config playwright.proveedores.config.ts",
    "test:catalogo": "playwright test --config playwright.catalogo.config.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "next": "16.4.1",
    "postcss": "^8.5.31",
    "primereact": "^10.9.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
