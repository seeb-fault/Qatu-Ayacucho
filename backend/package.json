{
  "name": "qatu-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "admin:crear": "node --env-file-if-exists=.env --import tsx scripts/aprovisionar-admin.ts",
    "documentos:limpiar": "node --env-file-if-exists=.env --import tsx scripts/limpiar-documentos.ts",
    "restauracion:verificar": "node --env-file-if-exists=.env --import tsx scripts/verificar-restauracion.ts",
    "openapi": "node --import tsx scripts/openapi.ts",
    "openapi:comprobar": "node --import tsx scripts/openapi.ts --comprobar",
    "archivos:mover": "node --env-file-if-exists=.env --import tsx scripts/mover-archivos.ts",
    "test:carga:catalogo": "node scripts/carga-catalogo.mjs",
    "carga:preparar": "node scripts/preparar-carga-catalogo.mjs",
    "test": "jest",
    "test:cobertura": "jest --coverage",
    "base:analizar": "node --env-file-if-exists=.env --import tsx scripts/analizar-base.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "11.4.8",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@usebruno/cli": "4.3.0",
    "jest": "30.5.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "scarfSettings": {
    "enabled": false
  }
}
