DATABASE_URL=postgresql://qatu:qatu_local@127.0.0.1:5433/qatu
JWT_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://127.0.0.1:3000
PORT=3001
NODE_ENV=development
DOCUMENTOS_KEY=
# Opcional: "inactivo" detiene la entrega de eventos a la bandeja de avisos.
QATU_DESPACHO_EVENTOS=
# Opcional: llaves de PRUEBA de Culqi (pk_test_ y sk_test_). Las llaves reales se rechazan al iniciar.
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
# Titular de Qatu para las páginas legales y el Libro de Reclamaciones (012). Vacíos se muestran como «Por definir».
QATU_TITULAR_RAZON_SOCIAL=
QATU_TITULAR_RUC=
QATU_TITULAR_DIRECCION=
QATU_TITULAR_CORREO=
QATU_TITULAR_TELEFONO=
# Opcional: dirección de escucha. Vacío = 127.0.0.1 (local). En Docker/Dokploy: 0.0.0.0, sin dominio ni puerto publicado.
QATU_HOST=
# Opcional: proxies cuya cabecera X-Forwarded-For se cree para conocer la IP real (límites de intentos).
# Solo con un proxy inverso delante que escriba esa cabecera. Dokploy (Traefik, servicios en contenedores): "uniquelocal".
# Todo en la misma máquina: "loopback". Vacío: se usa la IP de la conexión (la de Next) y los límites por IP son comunes a todo el sitio.
QATU_PROXIES_CONFIABLES=
# Almacén de archivos cifrados (013): vacío o "postgres" = dentro de PostgreSQL; "r2" = Cloudflare R2 con las variables
# QATU_R2_*. Tener las llaves no basta: hay que pedir "r2" aquí. Las pruebas (npm test) siempre usan PostgreSQL.
QATU_ALMACEN=
QATU_R2_ENDPOINT=
QATU_R2_ACCESS_KEY_ID=
QATU_R2_SECRET_ACCESS_KEY=
QATU_R2_BUCKET_PRIVADO=
QATU_R2_BUCKET_PUBLICO=
# Swagger (014): página en /api/v1/docs y contrato en /api/v1/docs/openapi.json. Vacío: encendido en desarrollo y apagado
# con NODE_ENV=production. "1" lo enciende siempre; "0" lo apaga.
QATU_DOCS=
