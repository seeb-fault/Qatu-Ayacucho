meta {
  name: Consultar la hoja con su código
  type: http
  seq: 3
}

get {
  url: {{api}}/reclamaciones/consulta?numero={{hojaNumero}}&codigo={{hojaCodigo}}
  body: none
  auth: none
}

params:query {
  numero: {{hojaNumero}}
  codigo: {{hojaCodigo}}
}

tests {
  test("200 con la misma hoja, aún sin respuesta", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().numero).to.equal(bru.getVar("hojaNumero"));
    expect(res.getBody()).to.not.have.property("codigoConsulta");
  });
}
