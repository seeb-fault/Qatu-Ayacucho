meta {
  name: Iniciar sesión como proveedor
  type: http
  seq: 2
}

post {
  url: {{api}}/auth/login
  body: json
  auth: none
}

headers {
  Origin: {{origen}}
  Content-Type: application/json
}

body:json {
  {
    "email": "{{proveedorEmail}}",
    "password": "{{fixturePassword}}"
  }
}

script:post-response {
  const c = [].concat(res.getHeader("set-cookie") || [])[0] || "";
  bru.setVar("cookieProveedor", c.split(";")[0]);
}

tests {
  test("200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
