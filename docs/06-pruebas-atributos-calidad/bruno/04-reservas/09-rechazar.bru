meta {
  name: El proveedor rechaza con motivo
  type: http
  seq: 9
}

post {
  url: {{api}}/reservas/{{reservaId}}/rechazo
  body: json
  auth: none
}

headers {
  Origin: {{origen}}
  Content-Type: application/json
  Cookie: {{cookieProveedor}}
}

body:json {
  {
    "versionActual": {{reservaVersion}},
    "motivo": "No tengo agenda libre en ese horario."
  }
}

tests {
  test("201 RECHAZADA con el motivo y una versión nueva", function () {
    expect(res.getStatus()).to.equal(201);
    const b = res.getBody();
    expect(b.estado).to.equal("RECHAZADA");
    expect(b.motivoRechazo).to.equal("No tengo agenda libre en ese horario.");
    expect(b.version).to.equal(Number(bru.getVar("reservaVersion")) + 1);
  });
}
