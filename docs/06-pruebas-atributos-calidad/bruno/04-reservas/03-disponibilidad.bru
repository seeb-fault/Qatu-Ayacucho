meta {
  name: Disponibilidad pública sin identidades
  type: http
  seq: 3
}

get {
  url: {{api}}/recursos/{{recursoId}}/disponibilidad?publicacionId={{publicacionId}}&inicio={{inicio}}&fin={{fin}}
  body: none
  auth: none
}

params:query {
  publicacionId: {{publicacionId}}
  inicio: {{inicio}}
  fin: {{fin}}
}

script:pre-request {
  // Una hora de un día dentro de tres semanas, a las 15:00 UTC (10:00 en Lima).
  const dia = new Date(Date.now() + 21 * 86400000); dia.setUTCHours(15, 0, 0, 0);
  bru.setVar("inicio", dia.toISOString());
  bru.setVar("fin", new Date(dia.getTime() + 3600000).toISOString());
}

tests {
  test("200 con franjas ocupadas y sin datos de quién", function () {
    expect(res.getStatus()).to.equal(200);
    const b = res.getBody();
    expect(b.franjas).to.be.an("array");
    for (const f of b.franjas) expect(f).to.have.all.keys("inicio", "fin");
    expect(b.enUso).to.be.a("boolean");
  });
}
