mxCell id="edge10" value="Avisos" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#667588;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1320" y="1060" as="sourcePoint"/><mxPoint x="1400" y="1060" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="edge11" value="Geografía" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#667588;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1320" y="1080" as="sourcePoint"/><mxPoint x="1400" y="1220" as="targetPoint"/><Array as="points"><mxPoint x="1360" y="1080"/><mxPoint x="1360" y="1220"/></Array></mxGeometry></mxCell><mxCell id="notes" value="&lt;b&gt;Lectura del diagrama y límites&lt;/b&gt;&lt;br/&gt;La vista resume responsabilidades; no representa la dirección de imports de Clean Architecture.&lt;br/&gt;Pagos pertenece a Reservas. IA solo interpreta búsquedas; el backend consulta información real.&lt;br/&gt;Un módulo opera sus propias tablas. Garantía documental sin custodia propia en el MVP." style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=none;strokeColor=#abb6c4;fontColor=#24364d;" vertex="1" parent="1"><mxGeometry x="28" y="1320" width="1644" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>