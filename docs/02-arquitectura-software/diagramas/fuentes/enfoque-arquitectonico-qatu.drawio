<mxfile host="app.diagrams.net"><diagram name="[Enfoque arquitectónico] Qatu — Clean Architecture"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="1370"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="&lt;b&gt;[Enfoque arquitectónico] Qatu — Clean Architecture&lt;/b&gt;&lt;br/&gt;Organización interna por módulo · Flechas continuas = dependencias de código" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=none;strokeColor=none;fontColor=#24364d;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1660" height="80" as="geometry"/></mxCell><mxCell id="boundary0" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=none;strokeColor=#8390a2;fontColor=#24364d;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="1580" height="1050" as="geometry"/></mxCell><mxCell id="boundary-label0" value="&lt;b&gt;API Qatu · Patrón aplicado dentro de cada módulo del monolito&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=none;strokeColor=none;fontColor=#24364d;" vertex="1" parent="1"><mxGeometry x="70" y="135" width="1560" height="35" as="geometry"/></mxCell><mxCell id="presentation" value="&lt;b&gt;PRESENTACIÓN&lt;/b&gt;&lt;br/&gt;Controladores, DTO y guards&lt;br/&gt;ReservasController&lt;br/&gt;BusquedaController" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#a8c7eb;strokeColor=#8196b1;fontColor=#142d48;" vertex="1" parent="1"><mxGeometry x="120" y="250" width="400" height="165" as="geometry"/></mxCell><mxCell id="application" value="&lt;b&gt;APLICACIÓN&lt;/b&gt;&lt;br/&gt;Casos de uso y coordinación&lt;br/&gt;AceptarReserva · ConfirmarPago&lt;br/&gt;BuscarEnLenguajeNatural" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#a8c7eb;strokeColor=#8196b1;fontColor=#142d48;" vertex="1" parent="1"><mxGeometry x="650" y="250" width="400" height="165" as="geometry"/></mxCell><mxCell id="composition" value="&lt;b&gt;COMPOSICIÓN&lt;/b&gt;&lt;br/&gt;NestJS module.ts y tokens&lt;br/&gt;Selecciona e inyecta adapters&lt;br/&gt;Conecta todas las capas" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#3f67ad;strokeColor=#8196b1;fontColor=white;" vertex="1" parent="1"><mxGeometry x="1180" y="250" width="400" height="165" as="geometry"/></mxCell><mxCell id="domain" value="&lt;b&gt;DOMINIO Y PUERTOS&lt;/b&gt;&lt;br/&gt;Reserva · RangoFechas · Dinero&lt;br/&gt;IntentoPago · CriteriosBusqueda&lt;br/&gt;RepositorioReservas · ProcesadorPagos&lt;br/&gt;InterpreteIntencion · Reloj&lt;br/&gt;Reglas sin ORM, framework ni SDK" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#8fb6dc;strokeColor=#8196b1;fontColor=#142d48;" vertex="1" parent="1"><mxGeometry x="580" y="575" width="540" height="255" as="geometry"/></mxCell><mxCell id="repos" value="&lt;b&gt;INFRAESTRUCTURA: datos&lt;/b&gt;&lt;br/&gt;PostgresReservasRepository&lt;br/&gt;Transacciones y exclusión de fechas" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#d9e6f5;strokeColor=#8196b1;fontColor=#142d48;" vertex="1" parent="1"><mxGeometry x="120" y="1000" width="400" height="120" as="geometry"/></mxCell><mxCell id="payment" value="&lt;b&gt;INFRAESTRUCTURA: pagos&lt;/b&gt;&lt;br/&gt;CulqiPagoAdapter&lt;br/&gt;Verificación y conciliación" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#d9e6f5;strokeColor=#8196b1;fontColor=#142d48;" vertex="1" parent="1"><mxGeometry x="650" y="1000" width="400" height="120" as="geometry"/></mxCell><mxCell id="model" value="&lt;b&gt;INFRAESTRUCTURA: IA&lt;/b&gt;&lt;br/&gt;ModeloLenguajeAdapter&lt;br/&gt;Timeout, cuota y validación" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#d9e6f5;strokeColor=#8196b1;fontColor=#142d48;" vertex="1" parent="1"><mxGeometry x="1180" y="1000" width="400" height="120" as="geometry"/></mxCell><mxCell id="edge0" value="Invoca caso de uso" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#667588;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="332" as="sourcePoint"/><mxPoint x="650" y="332" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="edge1" value="Depende de entidades y contratos" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#667588;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="415" as="sourcePoint"/><mxPoint x="850" y="575" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="edge2" value="Implementa repositorio" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#667588;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="1000" as="sourcePoint"/><mxPoint x="690" y="830" as="targetPoint"/><Array as="points"><mxPoint x="320" y="880"/><mxPoint x="690" y="880"/></Array></mxGeometry></mxCell><mxCell id="edge3" value="Implementa puerto de pagos" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#667588;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="1000" as="sourcePoint"/><mxPoint x="850" y="830" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="edge4" value="Implementa puerto de intención" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#667588;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1380" y="1000" as="sourcePoint"/><mxPoint x="1010" y="830" as="targetPoint"/><Array as="points"><mxPoint x="1380" y="880"/><mxPoint x="1010" y="880"/></Array></mxGeometry></mxCell><mxCell id="edge5" value="Inyecta" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#667588;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1180" y="332" as="sourcePoint"/><mxPoint x="1050" y="332" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="edge6" value="Configura adapters" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#667588;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1380" y="415" as="sourcePoint"/><mxPoint x="1380" y="1000" as="targetPoint"/><Array as="points"><mxPoint x="1560" y="415"/><mxPoint x="1560" y="950"/><mxPoint x="1380" y="950"/></Array></mxGeometry></mxCell><mxCell id="notes" value="&lt;b&gt;Lectura del diagrama y límites&lt;/b&gt;&lt;br/&gt;El dominio no importa NestJS, PostgreSQL, Culqi ni la API del modelo de IA.&lt;br/&gt;Las flechas de imports apuntan al núcleo; en ejecución los casos de uso llaman a los adapters por puertos.&lt;br/&gt;Frontend Next.js presenta datos y valida formularios; el backend decide tarifas, disponibilidad y pagos." style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=none;strokeColor=#abb6c4;fontColor=#24364d;" vertex="1" parent="1"><mxGeometry x="28" y="1240" width="1644" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>