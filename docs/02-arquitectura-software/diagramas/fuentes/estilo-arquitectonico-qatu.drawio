<mxfile host="app.diagrams.net"><diagram name="[Estilo arquitectónico] Qatu — cliente-servidor y monolito modular"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="1500"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="&lt;b&gt;[Estilo arquitectónico] Qatu — cliente-servidor y monolito modular&lt;/b&gt;&lt;br/&gt;Capas = organización lógica · Monolito = una unidad de despliegue backend" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=none;strokeColor=none;fontColor=#24364d;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1660" height="80" as="geometry"/></mxCell><mxCell id="boundary0" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=none;strokeColor=#8390a2;fontColor=#24364d;dashed=1;" vertex="1" parent="1"><mxGeometry x="80" y="345" width="1240" height="820" as="geometry"/></mxCell><mxCell id="boundary-label0" value="&lt;b&gt;API Qatu · NestJS · Seis módulos desplegados juntos&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=none;strokeColor=none;fontColor=#24364d;" vertex="1" parent="1"><mxGeometry x="90" y="350" width="1220" height="35" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b&gt;Cliente web / navegador&lt;/b&gt;&lt;br/&gt;Next.js · React · TypeScript&lt;br/&gt;Interfaz móvil: cliente, proveedor y admin" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#3f67ad;strokeColor=#8196b1;fontColor=white;" vertex="1" parent="1"><mxGeometry x="600" y="145" width="420" height="100" as="geometry"/></mxCell><mxCell id="presentation" value="&lt;b&gt;1. Presentación&lt;/b&gt;&lt;br/&gt;Controladores HTTP · JWT · roles y propiedad · validación de DTO" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#a8c7eb;strokeColor=#8196b1;fontColor=#142d48;" vertex="1" parent="1"><mxGeometry x="120" y="415" width="1160" height="95" as="geometry"/></mxCell><mxCell id="m0" value="&lt;b&gt;Usuarios&lt;/b&gt;&lt;br/&gt;[Módulo]&lt;b