 x="1375" y="680"/></Array></mxGeometry></mxCell><mxCell id="edge15" value="Adapters" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#667588;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1280" y="955" as="sourcePoint"/><mxPoint x="1400" y="955" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="edge16" value="SQL por módulo" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#667588;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="1130" as="sourcePoint"/><mxPoint x="300" y="1240" as="targetPoint"/><Array as="points"><mxPoint x="700" y="1190"/><mxPoint x="300" y="1190"/></Array></mxGeometry></mxCell><mxCell id="edge17" value="I/O autorizado" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#667588;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="1190" as="sourcePoint"/><mxPoint x="710" y="1240" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="edge18" value="Opcional" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#667588;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="1190" as="sourcePoint"/><mxPoint x="1110" y="1240" as="targetPoint"/><Array as="points"><mxPoint x="1110" y="1190"/></Array></mxGeometry></mxCell><mxCell id="edge19" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#667588;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="207" y="565" as="sourcePoint"/><mxPoint x="1182" y="565" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="edge20" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#667588;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="207" y="815" as="sourcePoint"/><mxPoint x="1182" y="815" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="notes" value="&lt;b&gt;Lectura del diagrama y límites&lt;/b&gt;&lt;br/&gt;Las flechas de esta vista son llamadas en ejecución; las reglas de imports se detallan en Clean Architecture.&lt;br/&gt;Los seis módulos comparten proceso y recursos. Modularidad no equivale a aislamiento de fallos.&lt;br/&gt;Despliegue inicial: web + API + PostgreSQL en un VPS con Docker Compose; no requiere microservicios." style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=none;strokeColor=#abb6c4;fontColor=#24364d;" vertex="1" parent="1"><mxGeometry x="28" y="1370" width="1644" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>