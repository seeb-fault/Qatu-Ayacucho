<mxfile host="app.diagrams.net"><diagram name="Componentes Qatu" id="qatu-c4-componentes"><mxGraphModel dx="1900" dy="1800" grid="1" gridSize="10" page="1" pageWidth="1900" pageHeight="1800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;[Diagrama de componentes] Qatu — API Backend&lt;/b&gt;&lt;br/&gt;Modelo C4 · Nivel 3 · Monolito modular · Alquiler de herramientas y servicios de oficios" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1850" height="65" as="geometry"/></mxCell><mxCell id="api-boundary" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7a8797;dashed=1;" vertex="1" parent="1"><mxGeometry x="65" y="420" width="1365" height="1000" as="geometry"/></mxCell><mxCell id="api-label" value="&lt;b&gt;API Qatu [Contenedor: NestJS · TypeScript · monolito modular]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="427" width="1250" height="35" as="geometry"/></mxCell><mxCell id="module-boundary" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9aa6b7;dashed=1;" vertex="1" parent="1"><mxGeometry x="120" y="700" width="1200" height="470" as="geometry"/></mxCell><mxCell id="cliente" value="&lt;b&gt;Cliente / visitante&lt;/b&gt;&lt;br/&gt;[Persona]&lt;br/&gt;Busca, reserva, paga y reseña" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontColor=#ffffff;fillColor=#274777;strokeColor=#7595be;" vertex="1" parent="1"><mxGeometry x="260" y="145" width="260" height="105" as="geometry"/></mxCell><mxCell id="proveedor" value="&lt;b&gt;Proveedor&lt;/b&gt;&lt;br/&gt;[Persona]&lt;br/&gt;Publica herramientas y oficios" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontColor=#ffffff;fillColor=#274777;strokeColor=#7595be;" vertex="1" parent="1"><mxGeometry x="690" y="145" width="260" height="105" as="geometry"/></mxCell><mx